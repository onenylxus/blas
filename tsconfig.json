{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "paths": {
      "@/utils/*": ["./utils/*.ts"],
      "@/*": ["./src/*"],
      "@f": ["./fortran-ts/src/index.ts"]
    },
    "noEmitOnError": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "out-tsc",
    "rootDir": "./"
  },
  "include": [
    "src/**/*.ts",
    "tests/testfn.ts",
    "utils/*.ts",
    "global.d.ts",
    "fortran-ts/global.d.ts"
  ],
  "exclude": [
    "fortran-ts/dist",
    "fortran-ts/eslint.config.ts",
    "fortran-ts/out-tsc",
    "fortran-ts/tests",
    "fortran-ts/types"
  ]
}
